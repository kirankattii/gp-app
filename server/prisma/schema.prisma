generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// USER
//////////////////////
model User {
  id              String  @id @default(uuid())
  name            String?
  email           String  @unique
  passwordHash    String?
  role            Role    @default(BUYER)
  googleId        String? @unique
  isEmailVerified Boolean @default(false)

  tokenVersion Int @default(0)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  verificationToken   String?
  verificationExpires DateTime?

  sellerProfile SellerProfile?

  productReviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////
// SELLER
//////////////////////
model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])

  legalDocuments LegalDocument[]
  products       Product[]

  storeName    String?
  businessType String?
  mobileNumber String?
  fullAddress  String?
  pincode      Int?
  town         String?
  district     String?
  state        String?
  country      String? @default("India")

  latitude  Float?
  longitude Float?

  gstin String? @unique
  pan   String? @unique

  bankAccountNumber String?
  ifscCode          String?

  approvalStatus    SellerStatus @default(PENDING)
  rejectionReason   String?
  profileCompletion Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////
// LEGAL DOCS
//////////////////////
model LegalDocument {
  id              String @id @default(uuid())
  sellerProfileId String

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
}

//////////////////////
// PRODUCT
//////////////////////
model Product {
  id String @id @default(cuid())

  productCode String @unique
  sellerId    String

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  title       String
  slug        String @unique
  description String

  category CategoryType
  features Json

  hsn                 String?
  country             String?
  manufacturer        String?
  manufacturerContact String?
  packerContact       String?

  netQuantity String?

  attributes Json? // renamed from categoryAttributes (cleaner)

  status ProductStatus @default(PENDING)

  rejectionReason String?
  isDeleted       Boolean @default(false)

  approvedAt  DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    ProductImage[]
  variants  ProductVariant[]
  documents ProductDocument[]
  packaging PackagingDeclaration?
  reviews   ProductReview[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([slug])
  @@index([productCode])
}

//////////////////////
// VARIANT
//////////////////////
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  skuCode String @unique

  size   String?
  color  String?
  weight String?
  ml     String?

  price Float
  stock Int   @default(0)

  reservedStock Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////
// IMAGES
//////////////////////
model ProductImage {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url    String
  isMain Boolean @default(false)

  createdAt DateTime @default(now())
}

//////////////////////
// DOCUMENTS
//////////////////////
model ProductDocument {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type DocumentType
  url  String

  createdAt DateTime @default(now())
}

//////////////////////
// PACKAGING
//////////////////////
model PackagingDeclaration {
  id String @id @default(cuid())

  productId String @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  primaryMaterial   String?
  secondaryMaterial String?

  refillable  Boolean @default(false)
  reusable    Boolean @default(false)
  plasticFree Boolean @default(false)
}

//////////////////////
// REVIEWS
//////////////////////
model ProductReview {
  id String @id @default(cuid())

  productId String
  userId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  rating Int
  review String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

//////////////////////
// ENUMS
//////////////////////
enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  BUYER
  SELLER
  ADMIN
  SUPERADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum CategoryType {
  PERSONAL_CARE
  BEAUTY
  HOME_KITCHEN
  FASHION
  SPORTS_FITNESS
}

enum DocumentType {
  INGREDIENT_LIST
  MATERIAL_LIST
  FRONT_LABEL
  BACK_LABEL
  CERTIFICATE
}
